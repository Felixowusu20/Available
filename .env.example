# PREMIUM_PRICE_PESEWAS 1000 = GHS 10. Existing users stay free until they pay or an admin grants access.
PAYSTACK_SECRET_KEY=""
PAYSTACK_ALLOW_LIVE="false"
PREMIUM_PRICE_PESEWAS="1000"
