# Copy to .env for local development. Never commit .env.
# In production set these in your host's environment / secret store instead.

# --- Database ---------------------------------------------------------------
# PostgreSQL 14+ connection string. The database user must be allowed to run
# CREATE EXTENSION pg_trgm (the first migration does this), or ask your DBA to
# create the extension once beforehand.
DATABASE_URL="postgresql://mdc:mdc@localhost:5432/mdc?schema=public"
# Max pooled connections per app process (default 10). Lower it on managed Postgres
# plans with a small connection limit, e.g. 5.
DATABASE_POOL_MAX="10"

# Docker Compose only (docker-compose.yml): the password for the bundled Postgres container.
# Compose builds the app's DATABASE_URL from it, so DATABASE_URL above is ignored there.
# Use a long random value: openssl rand -base64 24   (avoid characters like @ : / in it)
POSTGRES_PASSWORD="change-me"
# Docker Compose only: the host port the app is published on (localhost only). Default 3000.
# APP_PORT="3000"

# --- App / Auth -------------------------------------------------------------
# Public base URL of the site, no trailing slash. Used in emailed links.
APP_URL="http://localhost:3000"
# Random secret for signing session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me"
# Required by Auth.js when running behind a reverse proxy / on most hosts.
AUTH_TRUST_HOST="true"
# Set "false" to let users sign in before verifying their email (not for production).
REQUIRE_EMAIL_VERIFICATION="true"

# --- Email (SMTP) -----------------------------------------------------------
# If SMTP_HOST is empty, emails are NOT sent; links are printed to the server
# log instead (development only).
EMAIL_FROM="MDC Practice <no-reply@example.com>"
# In development the link is logged; in production it is never logged unless you set EMAIL_LOG_LINKS="true"
# (only for a local demo of a production build: a logged link is as good as a password).
# EMAIL_LOG_LINKS="false"
SMTP_HOST=""
SMTP_PORT="587"
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- AI (optional) ----------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run without AI; AI features show as unavailable.
ANTHROPIC_API_KEY=""
AI_TAGGING_MODEL="claude-haiku-5-5"
AI_QUALITY_MODEL="claude-sonnet-5-5"
# Effort level for the quality-check model: low | medium | high
AI_QUALITY_EFFORT="medium"

# --- Exam settings ----------------------------------------------------------
# Seconds allowed per question in timed exam mode (72 => 200 questions = 4h).
EXAM_SECONDS_PER_QUESTION="72"

# --- Seeding ----------------------------------------------------------------
# The first admin account, created/updated by `npm run db:seed:admin`.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me-to-a-long-passphrase"

# --- Logging ----------------------------------------------------------------
LOG_LEVEL="info"
