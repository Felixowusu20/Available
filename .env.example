DATABASE_URL=""
DATABASE_POOL_MAX="10"
APP_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
REQUIRE_EMAIL_VERIFICATION="true"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="admin12345"
EXAM_SECONDS_PER_QUESTION="72"
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true. Use an app password, not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Available <you@gmail.com>"
# Paystack secret key. Leave empty to switch payments off. Live webhook: https://YOUR-DOMAIN/api/paystack/webhook
# Premium is always GHS 10 (1,000 pesewas). A live key on Vercel production is allowed; elsewhere set PAYSTACK_ALLOW_LIVE=true.
PAYSTACK_SECRET_KEY=""
PAYSTACK_ALLOW_LIVE="false"
