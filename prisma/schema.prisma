generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum Section {
  PRECLINICAL
  CLINICAL
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionMode {
  LEARN
  EXAM
}

enum SessionKind {
  MOCK
  TOPIC
  REDO_MISSED
  BOOKMARKS
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ReportReason {
  WRONG_ANSWER
  UNCLEAR
  TYPO
  OUTDATED
  EXPLANATION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AiRunKind {
  TAG
  QUALITY
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique // always stored lower-case
  name          String?
  passwordHash  String? // null for future OAuth-only users
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  image         String?
  // Bumped on password reset so existing JWTs stop working.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts        Account[]
  authTokens      AuthToken[]
  sessions        PracticeSession[]
  answers         Answer[]
  bookmarks       Bookmark[]
  createdQuestion Question[]        @relation("QuestionCreatedBy")
  reviewed        Question[]        @relation("QuestionReviewedBy")
  aiRuns          AiRun[]
  reports         QuestionReport[] @relation("ReportedBy")
  resolvedReports QuestionReport[] @relation("ReportResolvedBy")
}

// Standard Auth.js account table. Unused until an OAuth provider (Google) is enabled.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// One-time tokens for email verification and password reset. Only the hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Question {
  id          String         @id @default(cuid())
  stem        String
  options     String[] // exactly 4, enforced by a CHECK constraint and by Zod
  correctIndex Int
  explanation String         @default("")
  // Null only while a question is untagged (fresh import). A CHECK constraint requires all
  // three for IN_REVIEW and PUBLISHED questions.
  section     Section?
  // Validated against taxonomy.json on every write (not a DB enum, so the taxonomy is editable).
  discipline  String?
  subtopic    String?
  difficulty  Difficulty?
  source      String?
  status      QuestionStatus @default(DRAFT)
  // Set by an admin. In mocks and topic practice, questions a student has not seen yet are
  // drawn high-priority first (see src/lib/practice/compose.ts). Never shown to students.
  highPriority Boolean       @default(false)

  // Normalised stem text used for pg_trgm duplicate detection.
  stemNorm    String
  // sha256 of normalised stem; makes seeding/imports idempotent.
  contentHash String         @unique
  // Original topic label from the legacy seed file, if any.
  legacyTopic String?

  // Latest AI metadata that an admin applied: { tags, confidence, flags, model, runId }.
  aiMeta      Json?

  createdById  String?
  reviewedById String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy  User? @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  sessionQuestions SessionQuestion[]
  bookmarks        Bookmark[]
  suggestions      AiSuggestion[]
  reports          QuestionReport[]

  @@index([status, section, discipline, subtopic])
  @@index([status, highPriority])
  @@index([stemNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Question_stemNorm_trgm_idx")
}

model PracticeSession {
  id               String      @id @default(cuid())
  userId           String
  kind             SessionKind
  mode             SessionMode
  questionCount    Int
  // Exam timer: deadline is fixed at start; there is no pause.
  timeLimitSeconds Int?
  startedAt        DateTime    @default(now())
  modeSwitchedAt   DateTime? // set when an EXAM session is switched to LEARN
  finishedAt       DateTime?
  // Selection criteria for TOPIC sessions, kept for display only.
  filter           Json?

  // Cached at finish so the dashboard (and any future leaderboard) stays cheap.
  correctCount     Int?
  answeredCount    Int?
  guessedCount     Int?
  correctGuessed   Int?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions SessionQuestion[]
  answers   Answer[]

  @@index([userId, startedAt])
  @@index([userId, finishedAt])
}

model SessionQuestion {
  id         String @id @default(cuid())
  sessionId  String
  position   Int // 0-based order within the session
  blockIndex Int // position / 50, for per-block breakdowns
  questionId String
  // Display order: optionOrder[i] is the canonical option index shown at slot i.
  optionOrder Int[]

  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer   Answer?

  @@unique([sessionId, position])
  @@index([questionId])
}

model Answer {
  id                String   @id @default(cuid())
  sessionQuestionId String   @unique
  sessionId         String
  userId            String
  questionId        String
  // Canonical option index (not display slot). Null when only flagged / timed.
  selectedIndex     Int?
  guessed           Boolean  @default(false)
  correct           Boolean?
  flagged           Boolean  @default(false)
  timeSpentMs       Int      @default(0)
  answeredAt        DateTime?
  updatedAt         DateTime @updatedAt

  sessionQuestion SessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  session         PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, questionId])
  @@index([userId, correct])
}

model Bookmark {
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}

// Fixed-window counters; Postgres-backed so it works across several app instances.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}

model AiRun {
  id           String    @id @default(cuid())
  kind         AiRunKind
  model        String
  requestedById String?
  questionCount Int      @default(0)
  succeeded    Int       @default(0)
  failed       Int       @default(0)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  cacheReadTokens Int    @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  error        String?

  requestedBy User?          @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  suggestions AiSuggestion[]

  @@index([startedAt])
}

// One reviewable AI result for one question. Never applied without admin action.
model AiSuggestion {
  id         String           @id @default(cuid())
  runId      String
  questionId String
  status     SuggestionStatus @default(PENDING)

  suggestedSection    Section?
  suggestedDiscipline String?
  suggestedSubtopic   String?
  suggestedDifficulty Difficulty?
  confidence          Float?
  // [{ code: "ANSWER_KEY_SUSPECT" | "MULTIPLE_DEFENSIBLE" | "WEAK_EXPLANATION" | "UNSAFE_DRUG_INFO", note: string }]
  flags               Json?
  draftedExplanation  String?
  // [{ questionId, similarity }]
  duplicates          Json?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedById String?

  run      AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([questionId])
}

// A student's report that a question looks wrong. A student has at most one OPEN report per question
// (a partial unique index in the migration enforces it); sending another updates it. Admins close all
// open reports on a question together as RESOLVED (fixed) or DISMISSED (no change needed).
model QuestionReport {
  id             String       @id @default(cuid())
  questionId     String
  userId         String
  reason         ReportReason
  comment        String       @default("")
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String       @default("")

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation("ReportedBy", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionId, status])
  @@index([userId, questionId])
}
